<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<!-- Use the local yak2d source when it is checked out beside this repo, unless UsePackages=true -->
	<ItemGroup Condition="Exists('..\..\..\yak2d\') And '$(UsePackages)' != 'true'">
		<ProjectReference Include="..\..\..\yak2d\src\Yak2D\Yak2D.csproj" />
	</ItemGroup>

	<!-- Otherwise use the Yak2D NuGet package (default likely for users) -->
	<ItemGroup Condition="!Exists('..\..\..\yak2d\') Or '$(UsePackages)' == 'true'">
		<PackageReference Include="Yak2D" Version="1.3.*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Textures\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Shaders\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Fonts\snappy_38.fnt" />
	  <None Remove="Fonts\snappy_38_0.png" />
	  <None Remove="Fonts\snappy_38_1.png" />
	  <None Remove="Fonts\snappy_64.fnt" />
	  <None Remove="Fonts\snappy_64_0.png" />
	  <None Remove="Fonts\snappy_64_1.png" />
	  <None Remove="Fonts\snappy_64_2.png" />
	  <None Remove="Fonts\snappy_64_3.png" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Fonts\snappy_38.fnt" />
	  <EmbeddedResource Include="Fonts\snappy_38_0.png" />
	  <EmbeddedResource Include="Fonts\snappy_38_1.png" />
	  <EmbeddedResource Include="Fonts\snappy_64.fnt" />
	  <EmbeddedResource Include="Fonts\snappy_64_0.png" />
	  <EmbeddedResource Include="Fonts\snappy_64_1.png" />
	  <EmbeddedResource Include="Fonts\snappy_64_2.png" />
	  <EmbeddedResource Include="Fonts\snappy_64_3.png" />
	</ItemGroup>

</Project>
